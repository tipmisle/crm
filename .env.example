APP_NAME="Beležka"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=sl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=crm

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Meta (Instagram + Facebook Messenger) — see README.md "Meta integration setup"
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/settings/integrations/meta/callback"
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Realtime Inbox updates (Laravel Reverb) — run `php artisan reverb:start`
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Public legal pages / provider identity — see config/legal.php and
# `php artisan legal:check`. Leave blank in dev; required before real
# production launch.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_LEGAL_FORM=
LEGAL_REGISTERED_ADDRESS=
LEGAL_REGISTRATION_NUMBER=
LEGAL_TAX_NUMBER=
LEGAL_VAT_REGISTERED=false
LEGAL_VAT_NUMBER=
LEGAL_EMAIL=
LEGAL_SUPPORT_EMAIL=
LEGAL_DPO_CONTACT=
LEGAL_TERMS_VERSION=2026-08-15
LEGAL_DPA_VERSION=2026-08-15
LEGAL_PRIVACY_VERSION=2026-08-15
LEGAL_COOKIE_VERSION=2026-08-15
LEGAL_GOVERNING_LAW="Republika Slovenija"
LEGAL_COMPETENT_COURT=

# Stripe billing — see docs/billing.md. Workspace is the Cashier billable
# entity, never User. Use Stripe TEST MODE keys in development; never
# commit real secrets.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_BELEZKA_MONTHLY_PRICE_ID=
BILLING_CURRENCY=eur
BILLING_DISPLAY_PRICE=
BILLING_PERIOD_LABEL="mesečno"
BILLING_PAST_DUE_ACCESS_POLICY=blocked
BILLING_POST_SUBSCRIPTION_ACCESS_POLICY=blocked
