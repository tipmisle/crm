APP_NAME="Beležka"
# PRODUCTION: APP_ENV=production, APP_DEBUG=false. APP_DEBUG=true in
# production leaks stack traces (including config values/queries) to any
# visitor who triggers a 500 — see docs/production-launch.md.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# PRODUCTION: must be the real https:// URL. This drives generated asset/
# route URLs, the `public` disk's file URL, mail's EHLO domain, and forces
# https on generated URLs (AppServiceProvider::boot()) — an http:// APP_URL
# in production silently leaves generated links on http.
APP_URL=http://localhost

APP_LOCALE=sl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Storage/interpretation timezone for every datetime column in the app —
# distinct from a workspace's own business timezone (Settings → workspace
# `timezone` column). Leave as UTC unless you have a specific reason to
# change it; if you do change it in production, every already-stored
# datetime is interpreted relative to the NEW value on next read, so this is
# not safe to flip after real data exists.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: LOG_LEVEL=error (or warning) — `debug` is noisy and can log
# more request detail than intended for a public-facing deployment.
LOG_LEVEL=debug
# Optional: send `critical`-and-above log entries to Slack — see
# config/logging.php's `slack` channel. Recommended in production so a
# stuck queue/webhook failure is actually seen by someone.
# LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=crm

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION REQUIRED: SESSION_SECURE_COOKIE=true — without this, session
# cookies are sent over plain http too, defeating HTTPS. Left unset (null)
# here so local http development still works; the login form fails silently
# in production behind http if this is forgotten. See config/session.php.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# PRODUCTION: if the app sits behind a reverse proxy / load balancer (nginx,
# Cloudflare, an ALB, etc.), Laravel must be told to trust its
# X-Forwarded-* headers or it will generate http:// URLs and misdetect the
# client IP/scheme even though the edge terminates TLS correctly. Comma-
# separated proxy IPs/CIDRs, or "*" to trust the immediate upstream (safe
# only when that upstream IS your proxy, e.g. a platform-managed LB where
# nothing else can reach the app directly). Leave blank for local dev.
TRUSTED_PROXIES=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Meta (Instagram + Facebook Messenger) — see README.md "Meta integration
# setup". PRODUCTION: META_WEBHOOK_VERIFY_TOKEN must be a long random value
# (used to verify the webhook subscription handshake) and the Meta App
# Dashboard's webhook URL must point at https://<APP_URL>/webhooks/meta.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/settings/integrations/meta/callback"
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Realtime Inbox updates (Laravel Reverb) — run `php artisan reverb:start`
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Web Push (used by App\Notifications\FollowUpDue). Generate a VAPID keypair
# once with `php artisan webpush:vapid` and keep it stable — rotating it
# invalidates every browser's existing push subscription.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Public legal pages / provider identity — see config/legal.php and
# `php artisan legal:check`. Leave blank in dev; required before real
# production launch. PRODUCTION (finalized owner values, see
# docs/legal-compliance.md §8): LEGAL_COMPANY_NAME="Web8, Josip Rajković
# s.p.", LEGAL_COMPANY_LEGAL_FORM="samostojni podjetnik (s.p.)",
# LEGAL_REGISTERED_ADDRESS="Zelena pot 3, 1241 Kamnik, Slovenija",
# LEGAL_REGISTRATION_NUMBER=8829888000, LEGAL_TAX_NUMBER=30631564,
# LEGAL_VAT_REGISTERED=true, LEGAL_VAT_NUMBER=SI30631564,
# LEGAL_EMAIL=info@belezka.com, LEGAL_SUPPORT_EMAIL=info@belezka.com,
# LEGAL_COMPETENT_COURT="stvarno pristojno sodišče v Ljubljani" — a court
# LEVEL (e.g. "Okrožno sodišče") must never be hardcoded here since
# substantive jurisdiction depends on the dispute; only the seat
# (Ljubljana) is fixed. LEGAL_DPO_CONTACT stays blank — no formally
# designated DPO; never set this to the owner's personal name.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_LEGAL_FORM=
LEGAL_REGISTERED_ADDRESS=
LEGAL_REGISTRATION_NUMBER=
LEGAL_TAX_NUMBER=
LEGAL_VAT_REGISTERED=false
LEGAL_VAT_NUMBER=
LEGAL_EMAIL=
LEGAL_SUPPORT_EMAIL=
LEGAL_DPO_CONTACT=
LEGAL_TERMS_VERSION=2026-08-17
LEGAL_DPA_VERSION=2026-08-17
LEGAL_PRIVACY_VERSION=2026-08-17
LEGAL_COOKIE_VERSION=2026-08-17
LEGAL_GOVERNING_LAW="Republika Slovenija"
LEGAL_COMPETENT_COURT=

# Stripe billing — see docs/billing.md. Workspace is the Cashier billable
# entity, never User. Use Stripe TEST MODE keys in development; never
# commit real secrets. PRODUCTION: use LIVE mode keys, a LIVE mode Price ID,
# and a webhook endpoint pointing at https://<APP_URL>/stripe/webhook with
# its own live signing secret — see docs/billing.md and
# docs/production-launch.md. Without STRIPE_WEBHOOK_SECRET set, webhook
# signature verification is never attached (Cashier only registers the
# VerifyWebhookSignature middleware when this is non-empty) — do not deploy
# with it blank.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_BELEZKA_MONTHLY_PRICE_ID=
# PRODUCTION (finalized launch price, see docs/billing.md §9): current
# launch is 1 subscription = 1 workspace, BILLING_DISPLAY_PRICE="9,90 €",
# BILLING_DISPLAY_PRICE_VAT_INCLUDED=true. Per-additional-workspace
# pricing (+6,90 €/month) is a future product decision, not implemented —
# do not set up Stripe quantity billing for it yet.
BILLING_CURRENCY=eur
BILLING_DISPLAY_PRICE=
BILLING_DISPLAY_PRICE_VAT_INCLUDED=
BILLING_PERIOD_LABEL="mesečno"
BILLING_PAST_DUE_ACCESS_POLICY=blocked
BILLING_POST_SUBSCRIPTION_ACCESS_POLICY=blocked
